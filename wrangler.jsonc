{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onecatalog",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "onecatalog.in/*", "zone_name": "onecatalog.in" },
    { "pattern": "*.onecatalog.in/*", "zone_name": "onecatalog.in" }
  ],
  "observability": { "enabled": true }
}
